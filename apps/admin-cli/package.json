{
  "name": "@mobouzer/admin-cli",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/danshilm/MoBouzer.git"
  },
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc --build --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint \"./src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"./src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write ./"
  },
  "dependencies": {
    "@mobouzer/database-schema": "workspace:*",
    "@mobouzer/eslint-config": "workspace:*",
    "@mobouzer/shared": "workspace:*",
    "@turf/distance": "^7.2.0",
    "axios": "^1.9.0",
    "commander": "^14.0.0",
    "common-tags": "^1.8.2",
    "dotenv": "^16.5.0",
    "lodash": "^4.17.21",
    "ora": "^8.2.0",
    "qs": "^6.14.0",
    "tsx": "^4.19.4",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/common-tags": "^1.8.4",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.15.30",
    "@types/qs": "^6.14.0",
    "drizzle-orm": "^0.44.2",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.44.2"
  },
  "eslintConfig": {
    "extends": "@mobouzer/eslint-config"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
