{
  "name": "@mobouzer/eslint-config",
  "description": "Base ESLint configuration to be used throughout the apps in the monorepo",
  "main": "index.js",
  "scripts": {
    "lint": "eslint \"./*.js\"",
    "lint:fix": "eslint \"./*.js\" --fix",
    "format": "prettier --write ./"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "8.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.18.1"
  },
  "eslintConfig": {
    "extends": "."
  }
}
